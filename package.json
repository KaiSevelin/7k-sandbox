{
  "name": "@sevenk/sandbox",
  "version": "0.1.0",
  "description": "A deterministic in-memory runtime for 7K models, with a virtual clock",
  "license": "Apache-2.0",
  "type": "module",
  "repository": { "type": "git", "url": "https://github.com/KaiSevelin/7k-sandbox.git" },
  "homepage": "https://github.com/KaiSevelin/7k-sandbox#readme",
  "bugs": { "url": "https://github.com/KaiSevelin/7k-sandbox/issues" },
  "keywords": ["7k", "sandbox", "simulation", "message-driven", "virtual-clock"],
  "engines": { "node": ">=20" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
